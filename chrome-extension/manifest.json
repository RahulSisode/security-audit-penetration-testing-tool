{
  "manifest_version": 3,
  "name": "WebGuard — Website Security & Vulnerability Scanner",
  "version": "1.0.0",
  "description": "Zero-API, 100% local website security, vulnerability assessment, leaked secret detector, and bug bounty reconnaissance scanner.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
